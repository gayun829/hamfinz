rules_version = '2';

// 프로덕션: quiz mastered / answers / sessions update — Cloud Functions(Admin SDK) 전용.
// 배포: node scripts/deploy_firestore_rules.mjs --production
// 개발 Rules: firestore.rules

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;

      // energy/streak 등은 퀴즈 Functions(submitAnswer·completeSession)만,
      // seeds/ownedShopItemIds/studyGuardCount는 상점 Functions(purchaseShopItem)만
      // 쓴다. 클라이언트가 같은 update()에서 이 필드들을 건드리면 거부한다 —
      // equipped*·nickname 등 나머지 필드는 계속 클라이언트가 직접 쓴다.
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'energy', 'lastEnergyResetDate', 'streak',
             'lastQuizCompletedDate', 'todayQuizCompleted', 'categoryStats',
             'incorrectQuestionCount', 'incorrectQuestionCounts', 'reviewArrivals',
             'seeds', 'ownedShopItemIds', 'studyGuardCount',
           ]);

      // 퀴즈: 맞춘 문제 id — 읽기만. 쓰기는 submitAnswer Functions.
      match /mastered/{questionId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // 퀴즈: 고유 오답 문제 — 읽기만. 쓰기는 submitAnswer Functions.
      match /incorrectQuestions/{questionId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // 퀴즈: startSession 시 inProgress 생성만 클라이언트. answers·완료는 Functions.
      match /sessions/{sessionId} {
        allow read, create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false;

        match /answers/{questionId} {
          allow read: if request.auth != null && request.auth.uid == uid;
          allow write: if false;
        }
      }
    }

    match /quizQuestions/{questionId} {
      allow read: if request.auth != null && resource.data.isActive == true;
      allow write: if false;
    }

    match /shopItems/{itemId} {
      allow read: if request.auth != null
        && resource.data.isActive == true;
      allow write: if false;
    }

    match /nicknames/{nicknameLower} {
      // 가입 흐름의 닉네임 중복 확인은 로그인 전에 일어나서 get은 비로그인에도 연다.
      // 대가: 누구나 닉네임을 알면 한 건씩 uid를 조회할 수 있고, 읽기 비용도 공개된다
      // (App Check로 막을 것). list는 로그인 사용자에게만 열려 있지만 소셜 가입이
      // 원터치라 목록 보호는 약하다 — 이 인덱스에는 uid·닉네임 말고 아무것도 두지 않는다.
      allow get: if true;
      allow list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'nickname']);
      allow update, delete: if false;
    }

    match /emails/{emailLower} {
      // 가입 이메일 화면의 중복 확인도 로그인 전이라 get은 비로그인에도 연다 —
      // nicknames와 같은 대가(메일을 알면 uid·닉네임 조회)를 치른다. list는 로그인 사용자만.
      allow get: if true;
      allow list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'nickname'])
        && emailLower == request.auth.token.email;
      allow update, delete: if false;
    }

    match /friendships/{friendshipId} {
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.uids);

      allow create: if request.auth != null
        && request.resource.data.uids is list
        && request.resource.data.uids.size() == 2
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(
             ['uids', 'requestedBy', 'requestedByNickname', 'status', 'createdAt']
           );

      allow update: if request.auth != null
        && request.auth.uid in resource.data.uids
        && request.auth.uid != resource.data.requestedBy
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.uids == resource.data.uids
        && request.resource.data.requestedBy == resource.data.requestedBy
        && request.resource.data.requestedByNickname == resource.data.requestedByNickname
        && request.resource.data.keys().hasOnly(
             ['uids', 'requestedBy', 'requestedByNickname', 'status', 'createdAt',
              'accepterNickname', 'acceptedAt']
           );

      allow delete: if request.auth != null && request.auth.uid in resource.data.uids;
    }

    // streaks: 캘린더 "이번 달 친구와의 경쟁"용. users 문서는 본인만 읽을 수 있어서
    // 연속학습 두 필드만 따로 둔다. 읽기는 본인과 수락된 친구만 — friendships 문서 id는
    // 두 uid를 정렬해 이어붙인 것이라 두 순서를 다 확인한다.
    // 쓰기는 본인 users 문서와 값이 같을 때만 허용한다. 프로덕션에서 users의 streak은
    // Functions 전용이라 이 인덱스도 부풀릴 수 없다.
    match /streaks/{uid} {
      function isFriend() {
        let a = /databases/$(database)/documents/friendships/$(request.auth.uid + '_' + uid);
        let b = /databases/$(database)/documents/friendships/$(uid + '_' + request.auth.uid);
        return (exists(a) && get(a).data.status == 'accepted')
          || (exists(b) && get(b).data.status == 'accepted');
      }

      allow read: if request.auth != null
        && (request.auth.uid == uid || isFriend());

      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['streak', 'lastQuizCompletedDate'])
        && request.resource.data.streak
             == get(/databases/$(database)/documents/users/$(uid)).data.get('streak', 0)
        && request.resource.data.lastQuizCompletedDate
             == get(/databases/$(database)/documents/users/$(uid)).data.get('lastQuizCompletedDate', null);

      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
